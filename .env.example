# agentchat environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable below is read at process startup by agentchat/__init__.py.

# ---- HTTP server ---------------------------------------------------------
# Bind address for the agentchat API.
AGENTCHAT_BIND=0.0.0.0
# Port for the agentchat API (default 7878).
AGENTCHAT_PORT=7878

# ---- Storage -------------------------------------------------------------
# Directory where the SQLite DB, tokens, config, and server.log live.
# Defaults to ~/.hermes/agent_chat if unset.
AGENTCHAT_HOME=/var/lib/agentchat

# ---- Auth rate limiting --------------------------------------------------
# Max /v1/auth/{login,register} attempts per 60s per client IP.
# Default 10. Set to 0 to disable (e.g. behind a trusted proxy or in tests).
LOGIN_RATE_LIMIT=10

# ---- Token policy --------------------------------------------------------
# Bearer access-token lifetime in seconds (default 86400 = 24h).
TOKEN_TTL_SECONDS=86400
# Refresh-token lifetime in seconds (default 2592000 = 30d).
REFRESH_TTL_SECONDS=2592000
#
# Passwords are hashed with hashlib.scrypt (n=2**15, r=8, p=1) — no bcrypt
# dependency and no cost-factor knob to configure.

# ---- Respond daemon (optional) -------------------------------------------
# The `agentchat respond` daemon reads its LLM provider/model/key from
# $AGENTCHAT_HOME/config.yaml (or ~/.hermes/config.yaml), not from env.
# See HANDOFF.md -> "Respond daemon" for the config.yaml schema. Example:
#
#   model:
#     default: MiniMax-M3
#     provider: minimax
#     base_url: https://api.minimax.io/v1
#     api_key: sk-...
